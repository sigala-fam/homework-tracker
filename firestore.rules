rules_version = '2';

// Firestore security rules for TaskNest.
//
// Copy these into the Firebase Console:
//   Firebase Console  ->  your project  ->  Firestore Database  ->  Rules tab
//   paste, then click "Publish".
//
// Why this matters: when a project starts in "test mode", Firebase creates
// temporary rules that STOP working after about 30 days and then block
// everyone. When that happens, sign-in still works but the app can't load
// your data, so the screen looks frozen. These rules fix that for good by
// letting each signed-in person read and write ONLY their own data.

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own document (boards list, settings) and everything nested
    // under it (their boards, tasks, etc.).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // "Suggest a feature" box. Signed-in people can ADD an idea, but nobody
    // can read, change or delete them from the app; the TaskNest team reads
    // them in the Firebase Console. Each idea must look exactly right:
    // a kind, 1–1000 characters of text, the real send time, and (only if
    // they ticked the box) their OWN email, never someone else's.
    match /suggestions/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['kind', 'text', 'createdAt', 'email'])
        && request.resource.data.kind in ['feature', 'improvement', 'bug', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && (!('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.email);
      allow read, update, delete: if false;
    }
  }
}
